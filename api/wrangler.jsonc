{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sde-intern-task-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my_db",
			"database_id": "2ff30f41-1416-454f-8cfe-068c49964381"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "13f31b4fad134839bbf00564d017b182"
		}
	]
}